{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vscode", "bun-types"],
    "typeRoots": ["./node_modules/@types", "../../node_modules"]
  },
  "include": ["src", "tests", "build.ts"]
}
