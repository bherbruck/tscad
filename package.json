{
  "name": "tscad",
  "version": "0.1.0",
  "description": "CAD as TSX: parametric solid models in React-style JSX, built on the solidcore B-rep kernel (WebAssembly)",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bherbruck/tscad.git"
  },
  "keywords": [
    "cad",
    "jsx",
    "tsx",
    "brep",
    "step",
    "stl",
    "3d-printing",
    "parametric",
    "solid-modeling",
    "wasm"
  ],
  "bin": {
    "tscad": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./kernel": "./src/kernel/index.ts",
    "./export": "./src/export/index.ts",
    "./ir": "./src/ir.ts",
    "./parts": "./src/parts/index.ts",
    "./render": "./src/render/index.ts",
    "./drawing": "./src/drawing/index.ts",
    "./mcp": "./src/mcp/index.ts"
  },
  "files": [
    "src",
    "wasm",
    "assets",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "build:wasm:dev": "bun scripts/build-wasm.ts --dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dev": "bun src/cli/index.ts dev examples/bracket.tsx"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/three": "^0.187.0",
    "bun-types": "^1.4.4",
    "codemirror": "^6.0.2",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2"
  }
}
